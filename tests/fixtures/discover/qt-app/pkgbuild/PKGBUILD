pkgname=tally
pkgver=0.3.0
pkgrel=1
pkgdesc='A counter for the desktop'
arch=('x86_64' 'aarch64')
url='https://example.org/tally'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland')
makedepends=('gcc' 'make')
source=()

build() {
  cd "$startdir/.."
  qmake6 && make
}

package() {
  cd "$startdir/.."
  install -Dm755 tally "$pkgdir/usr/bin/tally"
  install -Dm644 "$startdir/tally.desktop" "$pkgdir/usr/share/applications/tally.desktop"
}
