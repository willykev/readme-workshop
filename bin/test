#!/bin/sh
# Run the unit tests, then every plugin validator that is installed.
set -e
cd "$(dirname "$0")/.."
python3 -m unittest discover -s tests "$@"
run() { if command -v "$1" >/dev/null 2>&1; then echo "== $*"; "$@"; else echo "== $1 not installed, skipped"; fi; }
run claude plugin validate --strict .
run agy plugin validate --strict .
run grok plugin validate .
if command -v gh >/dev/null 2>&1 && gh skill --help >/dev/null 2>&1; then
  echo "== gh skill publish --dry-run"
  status=0
  out=$(gh skill publish --dry-run 2>&1) || status=$?
  printf '%s\n' "$out" | grep -v "no git remote" || true
  # The one complaint excused is that this checkout has no GitHub remote yet.
  if [ "$status" -ne 0 ] && ! { printf '%s\n' "$out" | grep -q "no git remote" \
      && ! printf '%s\n' "$out" | grep -qi "^error"; }; then
    echo "gh skill publish --dry-run failed (exit $status)"
    exit "$status"
  fi
fi
